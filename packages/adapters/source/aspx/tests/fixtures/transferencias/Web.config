<?xml version="1.0"?>
<!-- Banco Ficticio S.A.: aplicación de ejemplo, datos inventados. Sin credenciales: seguridad integrada. -->
<configuration>
  <connectionStrings>
    <add name="Banco" connectionString="Data Source=.;Initial Catalog=BancoFicticio;Integrated Security=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <pages enableViewState="true" />
  </system.web>
</configuration>
