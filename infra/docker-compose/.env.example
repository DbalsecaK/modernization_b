# Local environment. Do not edit secrets here: run `python infra/docker-compose/init_env.py`, which copies this
# file to .env and fills every empty *_PASSWORD, *_KEY, *_SECRET and *_SALT with a random value. Run it again after
# pulling: it appends the variables your .env is missing without changing the existing ones.

# Host ports (all bound to 127.0.0.1)
POSTGRES_PORT=5440
REDIS_PORT=6380
OPENFGA_HTTP_PORT=8190
NEO4J_HTTP_PORT=7476
NEO4J_BOLT_PORT=7689
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
LANGFUSE_PORT=3100
KEYCLOAK_PORT=8180
# Where the browser reaches the web app (the BFF callback goes through the Vite proxy).
WEB_ORIGIN=http://localhost:5173

# PostgreSQL roles
POSTGRES_PASSWORD=
PLATFORM_OWNER_PASSWORD=
PLATFORM_APP_PASSWORD=
AUTHZ_RELAY_PASSWORD=
KEYCLOAK_DB_PASSWORD=
OPENFGA_DB_PASSWORD=
LANGFUSE_DB_PASSWORD=

# Services
REDIS_PASSWORD=
OPENFGA_API_KEY=
NEO4J_PASSWORD=
MINIO_ROOT_USER=platform
MINIO_ROOT_PASSWORD=

# Keycloak: master admin, BFF client, admin service account and the password of the fictitious dev users
KC_BOOTSTRAP_ADMIN_PASSWORD=
KC_BFF_CLIENT_SECRET=
KC_ADMIN_CLIENT_SECRET=
KC_DEV_USER_PASSWORD=

# Langfuse (profile: observability). The encryption key must be 64 hex characters.
CLICKHOUSE_PASSWORD=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
